{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app-server",
    "types": [
      "node"
    ]
  },
  "angularCompilerOptions": {
    "entryModule": "app/app.server.module#AppServerModule",
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "files": [
    "src/main.server.ts",
    "server.ts"
  ]
}
